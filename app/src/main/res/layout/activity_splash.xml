<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Main Title ("GAME MATCH" in lime accent, starts invisible for animation) -->
        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:letterSpacing="0.16"
            android:scaleX="0.92"
            android:scaleY="0.92"
            android:text="GAME MATCH"
            android:textColor="@color/lime_accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline ("Play how you feel.", starts shifted down slightly for animation) -->
        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:text="Play how you feel."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:translationY="18dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
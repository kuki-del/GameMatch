<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/surface_elevated"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Zone Image + Badge pourcentage + Bouton Favori -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="135dp">

            <!-- Image de couverture (utilise le dégradé local hors-ligne) -->
            <ImageView
                android:id="@+id/img_game_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Game cover image"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_cover_placeholder" />

            <!-- Badge vert lime en haut à gauche ("98% match") -->
            <TextView
                android:id="@+id/tv_match_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_lime_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="98% match"
                android:textColor="@color/text_on_lime"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Bouton Cœur circulaire en haut à droite -->
            <ImageButton
                android:id="@+id/btn_favorite_card"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_dark"
                android:contentDescription="Toggle favorite"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/lime_accent" />
        </FrameLayout>

        <!-- Contenu texte sous l'image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Ligne Titre à gauche + Plateforme à droite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_game_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="The Quiet Wild"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_game_platform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PC"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Courte explication de correspondance -->
            <TextView
                android:id="@+id/tv_match_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Matches your Relaxed and Curious preferences."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Pastilles des moods du jeu -->
            <LinearLayout
                android:id="@+id/layout_game_moods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
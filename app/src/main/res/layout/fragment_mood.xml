<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="GAME MATCH"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Main Hero Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Play how you feel."
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Section Header & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="What's your energy today?"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pick up to 3 moods. We'll find your kind of play."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 3x3 Grid of Mood Toggle Buttons -->
        <GridLayout
            android:id="@+id/mood_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <!-- Row 1 -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_relaxed"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Relaxed"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIcon="@drawable/ic_check"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_curious"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Curious"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_adventurous"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Adventurous"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <!-- Row 2 -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_creative"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Creative"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_competitive"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Competitive"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_social"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Social"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <!-- Row 3 -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_focused"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Focused"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_nostalgic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Nostalgic"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_energetic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_columnWeight="1"
                android:text="Energetic"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_on_lime"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="14dp"
                app:chipStrokeWidth="0dp" />
        </GridLayout>

        <!-- Platform Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Where do you play?"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Platform Dropdown Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:strokeWidth="0dp">

            <Spinner
                android:id="@+id/spinner_platform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Lime CTA Button ("Find my game >") -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_find_game"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/lime_accent"
            android:text="Find my game   ›"
            android:textAllCaps="false"
            android:textColor="@color/text_on_lime"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <!-- Bottom Info Card ("Less scrolling. More playing.") -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/surface_banner"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Favorite icon"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="@color/lime_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Less scrolling. More playing."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="A little intuition. A much better game night."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>